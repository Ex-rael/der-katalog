<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!--
    Spring Boot 4.1.x é a linha com suporte OSS corrente (até 2027-07-31).
    A 3.3.x pedida na versão 1.0 do documento perdeu o suporte OSS em
    2025-06-30 e a 3.5.x em 2026-06-30; permanecer numa linha morta
    contraria o §A06 do plano de segurança.
  -->
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.1</version>
    <relativePath/>
  </parent>

  <groupId>br.com.chimaclub</groupId>
  <artifactId>chimaclub</artifactId>
  <version>1.0.0-SNAPSHOT</version>
  <name>Chima Club</name>
  <description>Catálogo de cuias e acessórios para chimarrão</description>

  <properties>
    <java.version>21</java.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <uuid-creator.version>6.1.1</uuid-creator.version>
    <thumbnailator.version>0.4.20</thumbnailator.version>
    <webp-imageio.version>0.1.6</webp-imageio.version>
    <bucket4j.version>8.14.0</bucket4j.version>
    <zxing.version>3.5.4</zxing.version>
    <dependency-check.version>12.1.0</dependency-check.version>
    <cyclonedx.version>2.9.1</cyclonedx.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <!--
      No Spring Boot 4 a autoconfiguração do Flyway vive no seu próprio
      starter; o flyway-core sozinho é apenas a biblioteca, e as migrações
      nunca rodariam.
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-flyway</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!-- UUID v7: ordenado no tempo. O PostgreSQL só oferece v4. -->
    <dependency>
      <groupId>com.github.f4b6a3</groupId>
      <artifactId>uuid-creator</artifactId>
      <version>${uuid-creator.version}</version>
    </dependency>

    <!--
      Código QR da ativação do segundo fator. Só o "core": a conversão do
      BitMatrix em PNG é vinte linhas, e o módulo "javase" traria junto
      leitura de imagem e linha de comando, que não usamos.
    -->
    <dependency>
      <groupId>com.google.zxing</groupId>
      <artifactId>core</artifactId>
      <version>${zxing.version}</version>
    </dependency>

    <!--
      Limite de requisições por IP (§A04). Em memória: há um processo só, e
      a escala prevista é de centenas de visitas por dia.
    -->
    <dependency>
      <groupId>com.bucket4j</groupId>
      <artifactId>bucket4j_jdk17-core</artifactId>
      <version>${bucket4j.version}</version>
    </dependency>

    <!--
      Processamento de imagem. O ImageIO do Java lê WebP mas não grava; o
      escritor vem da nativa do webp-imageio, cujo carregamento é conferido
      por teste (ProcessadorImagemTest.saidaEhWebpLegivel).
    -->
    <dependency>
      <groupId>net.coobird</groupId>
      <artifactId>thumbnailator</artifactId>
      <version>${thumbnailator.version}</version>
    </dependency>
    <dependency>
      <groupId>org.sejda.imageio</groupId>
      <artifactId>webp-imageio</artifactId>
      <version>${webp-imageio.version}</version>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-thymeleaf</artifactId>
    </dependency>
    <!--
      Actuator apenas para health e info, e só na porta administrativa.
      env, heapdump e threaddump ficam desligados por configuração (§A05).
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <!-- th:if="${#authorization...}" e o token CSRF nos formulários -->
    <dependency>
      <groupId>org.thymeleaf.extras</groupId>
      <artifactId>thymeleaf-extras-springsecurity6</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!--
      No Spring Boot 4 as autoconfigurações de teste foram divididas em
      módulos próprios: @AutoConfigureMockMvc vem do webmvc-test, e o apoio
      a @WithMockUser e csrf() vem do security-test do Boot, não do
      spring-security-test cru.
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-security-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-testcontainers</artifactId>
      <scope>test</scope>
    </dependency>
    <!--
      Testcontainers 2.x, gerenciado pelo spring-boot-dependencies. Os
      artefatos foram renomeados na versão 2: o que era "postgresql" agora
      é "testcontainers-postgresql".
    -->
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>

  <!--
    A varredura de segurança fica num perfil próprio, e não no build padrão.

    O dependency-check baixa a base de vulnerabilidades e leva minutos. Preso
    a todo "verify", ele tornaria o ciclo de desenvolvimento penoso a ponto
    de alguém desligá-lo — e um controle desligado protege menos que um
    controle que roda uma vez por mês e é lido.

    O ciclo mensal do §A06 executa:  ./mvnw verify -Pseguranca
  -->
  <profiles>
    <profile>
      <id>seguranca</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.owasp</groupId>
            <artifactId>dependency-check-maven</artifactId>
            <version>${dependency-check.version}</version>
            <configuration>
              <!-- Falha em severidade 7 ou mais, como manda o §A06. -->
              <failBuildOnCVSS>7</failBuildOnCVSS>
              <formats>
                <format>HTML</format>
                <format>JSON</format>
              </formats>
              <outputDirectory>${project.build.directory}/seguranca</outputDirectory>
              <!-- Analisadores de ecossistemas que este projeto não usa. -->
              <nodeAnalyzerEnabled>false</nodeAnalyzerEnabled>
              <assemblyAnalyzerEnabled>false</assemblyAnalyzerEnabled>
              <ossindexAnalyzerEnabled>false</ossindexAnalyzerEnabled>
              <suppressionFiles>
                <suppressionFile>docs/supressoes-dependency-check.xml</suppressionFile>
              </suppressionFiles>
            </configuration>
            <executions>
              <execution>
                <goals><goal>check</goal></goals>
              </execution>
            </executions>
          </plugin>

          <!--
            Inventário de dependências (SBOM) a cada versão. Serve para
            responder, no dia em que sair uma falha grave numa biblioteca,
            à pergunta "isso está aqui dentro?" sem precisar adivinhar.
          -->
          <plugin>
            <groupId>org.cyclonedx</groupId>
            <artifactId>cyclonedx-maven-plugin</artifactId>
            <version>${cyclonedx.version}</version>
            <configuration>
              <outputDirectory>${project.build.directory}/seguranca</outputDirectory>
              <outputName>inventario-de-dependencias</outputName>
              <includeTestScope>false</includeTestScope>
            </configuration>
            <executions>
              <execution>
                <phase>package</phase>
                <goals><goal>makeAggregateBom</goal></goals>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
