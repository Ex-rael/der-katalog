# Segredos — nunca versionados (§4.4 do plano de segurança)
secrets/
*.env
.env.*
!.env.example

# Backups
backups/

# Build
target/
!.mvn/wrapper/maven-wrapper.jar

# Fotos enviadas em desenvolvimento
fotos/

# IDE
.idea/
*.iml
.vscode/
.settings/
.classpath
.project

# Sistema
.DS_Store
*.log

# Pacote de implantação: leva secrets/ dentro dele, e um .zip não é
# alcançado pela regra "secrets/" acima — o arquivo compactado entraria
# no repositório com a senha do banco e a chave do TOTP dentro.
chima/
chima.zip
*.zip

# Terraform — o state e as .tfvars guardam IDs da conta e segredos (token do
# túnel); o diretório .terraform guarda o binário do provider (~100 MB).
# O .terraform.lock.hcl, esse sim, é versionado.
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
*.tfvars.json
crash.log
